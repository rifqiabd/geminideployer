{
	"name": "gemini-deployer",
	"main": "src/index.ts",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"compatibility_date": "2026-09-18",
	// Fetch ke proxy image generation (imggen-proxy.*.workers.dev) yang satu akun
	// diblokir Cloudflare (error code 1042) kalau flag ini tidak dipasang.
	"compatibility_flags": ["global_fetch_strictly_public"],
	// OPSIONAL - fitur "Generate AI" di panel Gambar: gambar slot dibuat dari
	// prompt teks lewat proxy free-image-generation-api (Workers AI, gratis
	// 100rb panggilan/hari). Deploy dulu proxy dari
	// github.com/saurav-z/free-image-generation-api, lalu set secret-nya:
	//   npx wrangler secret put IMGGEN_API_URL
	//   npx wrangler secret put IMGGEN_API_KEY
	//
	// AKTIF. Gambar soal disimpan di sini, bukan di KV: kuota R2 free jauh lebih
	// longgar (1 juta Class A per BULAN) dibanding KV yang cuma 1.000 tulis per
	// HARI. Gambar lama yang masih di KV tetap terbaca dan pindah sendiri ke sini
	// saat pertama kali dibaca, jadi tidak perlu migrasi manual.
	// Kalau binding ini dihapus, media otomatis turun ke KV tanpa perubahan kode.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "gemini-media"
		}
	],
	// Ajakan PPDB 2027/2028 di banner dashboard. Tombol "Daftar Sekarang" selalu
	// tampil; nomor WhatsApp panitia (format internasional tanpa "+", mis.
	// 6281234567890) membuatnya langsung menuju chat admin. Kalau kosong,
	// WhatsApp terbuka dengan pesan siap kirim lalu panitia dipilih manual.
	"vars": {
		"PPDB_WHATSAPP": ""
	},
	"kv_namespaces": [
		{
			"binding": "STORAGE",
			"id": "eccfd622d7004c58ae8e9c8e1d223ba2",
			// false (bukan true) sejak kuota harian KV free adalah 1.000 tulis +
			// 1.000 hapus + 1.000 list per HARI. Dengan true, setiap sesi
			// `wrangler dev` lokal memakai kuota produksi yang sama dan ikut
			// habis sehingga aplikasi gagal menulis. Set true hanya kalau
			// memang perlu menguji terhadap data produksi.
			"remote": false
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gemini-db",
			"database_id": "3ca2f617-70f7-4048-a610-558a0fad7ebd"
		}
	],
	"env": {
		"staging": {
			"name": "gemini-deployer-staging",
			"vars": {
				"PPDB_WHATSAPP": "6285183331506"
			},
			"kv_namespaces": [
				{
					"binding": "STORAGE",
					"id": "26f5f45fa7894f6faf8ba6a97e97f53e",
					"remote": false
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gemini-db-staging",
					"database_id": "f44392a6-e445-41b4-a8ab-ca2ec9caba3a"
				}
			],
			// Bucket TERPISAH dari produksi (gemini-media). Kalau staging memakai
			// bucket yang sama, satu slug yang kebetulan sama bisa menimpa
			// gambar produksi. Media di staging sengaja dibiarkan kosong dulu.
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "gemini-media-staging"
				}
			]
		}
	}
}