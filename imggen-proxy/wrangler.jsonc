{
	"name": "imggen-proxy",
	"main": "worker.js",
	"compatibility_date": "2026-09-18",
	// Binding AI: fitur "Workers AI" harus aktif di akun Cloudflare (gratis).
	// Kalau deploy gagal dengan pesan soal AI binding, aktifkan lewat dashboard:
	// Workers & Pages > AI > Enable (lihat langkah 5 di README repo sumber).
	"ai": {
		"binding": "AI"
	}
	// API_KEY di-set sebagai secret: npx wrangler secret put API_KEY
}
